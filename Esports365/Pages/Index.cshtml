@page
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Esports365 — student esports team tracker, fixtures and demo results">
<title>Esports365 | Login</title>
<link rel="stylesheet" href="/css/site.css">
<style> .course-demo-label { letter-spacing: .03em; } </style>
<script src="/js/site.js" defer></script>
</head>
<body data-page="login" style="--page-accent:#f5b942">
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header"><div class="header-inner"><div class="brand"><img class="brand-map" src="/img/esports-badge.svg" width="240" height="72" alt="Esports365 project logo — click to learn about us" usemap="#brand-map"><map name="brand-map"><area shape="rect" coords="0,0,240,72" href="/About" alt="About Esports365"></map></div><nav class="menu" aria-label="Main navigation"><a href="/Home" >Home</a><a href="/Matches" >Matches</a><a href="/ChooseTeam" >Favorite Team</a><a href="/About" >About Us</a><a href="/" aria-current="page" >Login</a><a href="/SignUp" class="menu-cta">Sign Up</a></nav></div></header>
<main id="main-content" class="container"><div class="login-container"><section class="login-card"><h1>ESPORTS 365</h1><h2>Welcome Back!</h2><p class="subtitle">Sign in to follow your favorite esports teams.</p><form id="auth-form" data-next="/ChooseTeam"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="name@example.com" autocomplete="email" required><label for="password">Password</label><input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required minlength="6"><div class="remember"><input type="checkbox" id="remember" name="remember"><label for="remember">Remember me (demo only)</label></div><input type="submit" value="Continue to demo" class="login-button"><p id="auth-feedback" class="feedback" role="status" hidden></p></form><p class="signup">Don't have an account? <a href="/SignUp">Sign Up</a></p><p class="helper">Prototype only — no credentials are sent to a server or saved.</p></section></div></main>
<footer class="footer"><div class="footer-inner"><span>© 2026 Esports365 · CPIS358 university course project</span><span><a href="/About">About Us</a><a href="/Matches">Matches</a><a href="/Home#top">Back to top</a></span></div></footer>
</body></html>
